# DeepSeek（打分用；不填也能跑，只用规则分）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 求职硬条件（个人信息，只在本地）
TARGET_SALARY_MIN=25        # 期望月薪下限（千元）
TARGET_SALARY_IDEAL=30      # 理想月薪（千元）
CITIES=深圳                  # 目标城市，多个用逗号分隔
ACCEPT_REMOTE=true
MUST_HAVE=双休
AVOID="外包,驻场,数据标注,算法研究岗（偏论文）,纯 CRUD 业务"

# 重点关注的公司（看板高亮 + 打分加权，逗号分隔）
TARGET_COMPANIES="公司A,公司B"

# 每日任务
DAILY_QUERIES="AI大模型,大模型平台,模型接入,推理服务,AI网关,Agent开发,LLM,AI应用开发,后端开发 AI"
TENCENT_QUERIES=大模型,AI,Agent,推理,后台开发,后端
OFFICIAL_QUERIES=大模型,AI,Agent,推理,后台开发,后端
# OFFICIAL_SOURCES=bytedance,xiaomi,alibaba,antgroup,meituan,baidu,huawei,vivo,netease,jd
MAX_PAGES=2
DETAIL_LIMIT=30
SCORE_LIMIT=200
SCORE_CONCURRENCY=4
TOP_N=20
MIN_SCORE=68
STALE_DAYS=14
BLOCK_COOLDOWN_HOURS=12
QUERY_BUDGET=8
BREADTH_MIN_NEW=30

# 浏览器：有界面 + 窗口在屏幕外（不要用无头，会被 BOSS/猎聘识别）
CHROME_CHANNEL=chrome
HEADLESS=false
OFFSCREEN=true

PORT=5173

# 浏览即采集：「打开今天的搜索页」用的浏览器（要和装采集脚本的一致）、词数、平台
SEARCH_BROWSER="Google Chrome"
OPEN_KEYWORDS_COUNT=2
OPEN_PLATFORMS=boss,liepin,zhaopin

# DeepSeek 单价（元 / 百万 tokens），按官网价格调整；缓存命中单价默认按 1/10 估
# PRICE_IN=3
# PRICE_IN_HIT=0.3
# PRICE_OUT=6
